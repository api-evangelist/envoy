          "name": "Envoy Drain listeners",
          "request": {
            "name": "Envoy Drain listeners",
            "description": {
              "content": "Initiates graceful draining of all listeners, stopping new connections from being accepted while allowing existing connections to complete. Useful before shutting down an Envoy instance or removing it from a load balancer.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "drain_listeners"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "inboundonly",
                  "value": "false",
                  "description": "When true, only drain inbound listeners."
                },
                {
                  "disabled": false,
                  "key": "graceful",
                  "value": "false",
                  "description": "When true, perform a graceful drain that allows time for connections to complete."
                }
              ],
              "variable": []
