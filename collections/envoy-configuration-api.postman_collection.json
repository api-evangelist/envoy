      "item": [
        {
          "id": "135b1c14-5ce4-4fdc-8e6a-c5a8a9c7f281",
          "name": "Dump current Envoy configuration",
          "request": {
            "name": "Dump current Envoy configuration",
            "description": {
              "content": "Returns the currently loaded Envoy configuration as a JSON object containing bootstrap, clusters, listeners, routes, secrets, and endpoints. Supports filtering by resource type and name regex to reduce output size.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "config_dump"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "resource",
                  "value": "<string>",
                  "description": "Filter by resource type. Valid values include static_clusters, dynamic_active_clusters, static_listeners, dynamic_active_listeners, dynamic_route_configs, static_route_configs, and bootstrap."
                },
                {
                  "disabled": false,
                  "key": "name_regex",
                  "value": "<string>",
                  "description": "Filter resources by name using a regular expression pattern."
                },
                {
                  "disabled": false,
                  "key": "include_eds",
                  "value": "false",
                  "description": "Include EDS endpoint assignment data in the config dump."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "107f071e-1e29-4873-839b-31b60fdda186",
              "name": "Configuration dump retrieved successfully",
              "originalRequest": {
                "url": {
