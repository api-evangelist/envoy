          "name": "Envoy Drain listeners",
          "request": {
            "name": "Envoy Drain listeners",
            "description": {
              "content": "Drains all listeners, preventing new connections from being accepted. Existing connections are allowed to complete.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "drain_listeners"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "inboundonly",
                  "value": "false",
                  "description": "Only drain inbound listeners"
                },
                {
                  "disabled": false,
                  "key": "graceful",
                  "value": "false",
                  "description": "Perform graceful drain"
