        {
          "id": "6ca971bb-91b7-45c5-a8cf-3127670a135a",
          "name": "Envoy Change log levels",
          "request": {
            "name": "Envoy Change log levels",
            "description": {
              "content": "Dynamically changes the logging level for one or all loggers without restarting Envoy. Use the level query parameter to set all loggers or the paths parameter to set a specific logger at logger_name:level format.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "logging"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "level",
                  "value": "<string>",
                  "description": "Set log level for all loggers simultaneously. One of trace, debug, info, warning, error, critical, or off."
                },
                {
                  "disabled": false,
                  "key": "paths",
                  "value": "<string>",
                  "description": "Set log level for a specific logger using logger_name:level format. Can be specified multiple times for multiple loggers."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "text/plain"
              }
            ],
