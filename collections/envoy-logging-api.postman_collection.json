          "name": "Envoy Get current log levels",
          "request": {
            "name": "Envoy Get current log levels",
            "description": {
              "content": "Returns the current logging levels for all named loggers configured in the Envoy instance. Logger names correspond to subsystems such as http, router, upstream, conn_handler, and others.",
